# Copy this file to ".env" and paste your real key.
#   cp .env.example .env
#
# Get a key at https://console.anthropic.com/  ->  Settings -> API Keys.
# This is what powers the Python scripts. (If you use Cursor/Copilot, that's a
# SEPARATE subscription and does NOT power this code — you still need this key.)

ANTHROPIC_API_KEY=sk-ant-paste-your-key-here

# Optional: pin a model for every lesson without editing each file.
# Defaults to a current Claude model if unset.
# ANTHROPIC_MODEL=claude-sonnet-4-6
